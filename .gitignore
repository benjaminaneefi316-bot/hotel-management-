# --------------------------------------------------------------------------
# Environment files (never commit secrets)
# --------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.production.example
backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.production.example

# --------------------------------------------------------------------------
# Laravel
# --------------------------------------------------------------------------
backend/vendor/
backend/node_modules/
backend/storage/*.key
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*
backend/public/build/
backend/public/hot
backend/public/storage
backend/database/*.sqlite
backend/.phpunit.result.cache
backend/.phpunit.cache/

# --------------------------------------------------------------------------
# Flutter / Dart
# --------------------------------------------------------------------------
mobile/.dart_tool/
mobile/.packages
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/android/.gradle/
mobile/android/local.properties
mobile/**/*.iml

# --------------------------------------------------------------------------
# Local backups / restore artefacts produced by the app at runtime
# --------------------------------------------------------------------------
backend/storage/app/backups/*.sql
backend/storage/app/backups/*.sql.gz
backend/storage/app/backups/*.sql.enc
backend/storage/app/restore-points/*.json

# --------------------------------------------------------------------------
# Editors & OS
# --------------------------------------------------------------------------
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini
*.log

# --------------------------------------------------------------------------
# Local dev database + runtime scratch space (kept out of the repo)
# --------------------------------------------------------------------------
localdb/
tools/.env.local

# Local-only run artefacts: SQLite scratch db, captured mail, test cookies and
# dev server logs. Never part of the deployable application.
data/
backend/database/*.sqlite
backend/database/*.sqlite-*
