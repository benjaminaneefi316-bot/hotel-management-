# ---------------------------------------------------------------------------
# Secure Hotel Management System - environment template
#
# Copy to `.env` and fill in the blanks:   cp .env.example .env
# Then generate the secrets with:          php artisan security:generate-secrets
#
# NEVER commit a real `.env`. Every value below is either a placeholder or a
# safe development default. See docs/INSTALLATION.md and docs/SECURITY.md.
# ---------------------------------------------------------------------------

APP_NAME="Azure Bay Hotel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# ---------------------------------------------------------------------------
# Hashing: Argon2id + per-user salt + application pepper
# (config/hashing.php defaults to argon2id even if HASH_DRIVER is unset.)
# ---------------------------------------------------------------------------
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4
ARGON_VERIFY=true
BCRYPT_ROUNDS=12

# Application secrets - generate with `php artisan security:generate-secrets`.
#   APP_PASSWORD_PEPPER : 64 hex chars, never stored in the database
#   APP_ENCRYPTION_KEY  : base64 of 32 random bytes, protects encrypted guest fields
#   APP_PASSWORD_PEPPER_PREVIOUS : comma-separated old peppers during a rotation
APP_PASSWORD_PEPPER=
APP_PASSWORD_PEPPER_PREVIOUS=
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Email OTP (two-factor authentication)
# ---------------------------------------------------------------------------
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS_PER_HOUR=5
TWO_FACTOR_CHALLENGE_MINUTES=10

# DANGER: only ever `true` on a local machine. It renders the OTP on screen so
# the flow can be demonstrated without a mailbox. MUST be false in production.
TWO_FACTOR_EXPOSE_CODE=false

# Login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=60

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database (MySQL 8 / MariaDB 10.6+)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel_management
DB_USERNAME=hotel_app
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions (encrypted, http-only cookies)
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail - used to deliver two-factor codes and backup failure alerts.
# Use a real transactional mailer in production (SMTP / SES / Mailgun / Postmark).
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="benjaminaneefi316@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Backups -> encrypted MySQL dump -> Amazon S3
#
#   BACKUP_DRIVER=local : simulate entirely on disk, no AWS credentials needed
#   BACKUP_DRIVER=s3    : upload to the bucket below
# ---------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_DRIVER=local
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_ENABLED=true
BACKUP_TIME=02:30
BACKUP_TIMEZONE=UTC
BACKUP_TIMEOUT_SECONDS=900
BACKUP_ALERT_EMAIL=

# Full path to mysqldump/mariadb-dump when it is not on the PATH.
MYSQLDUMP_BINARY=

# Dump stored routines/events as well. Off by default because they need extra
# database privileges the application user should not hold (least privilege).
BACKUP_DUMP_ROUTINES=false
BACKUP_DUMP_EVENTS=false

# ---------------------------------------------------------------------------
# AWS - never hard-code credentials. On EC2/Railway/Render inject them as
# environment variables or attach an instance/task role. See docs/AWS_DEPLOYMENT.md.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_BACKUP_BUCKET=
AWS_BACKUP_PREFIX=hotel-backups
AWS_BACKUP_SSE=AES256
AWS_BACKUP_KMS_KEY_ID=
AWS_BACKUP_STORAGE_CLASS=STANDARD_IA
AWS_BACKUP_VERSIONING=true
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Container boot behaviour (read by docker/entrypoint.sh).
#   RUN_MIGRATIONS : run `php artisan migrate --force` on every boot
#   RUN_SEEDERS    : run the guarded `demo:seed` (seeds ONLY an empty database)
#   CACHE_APP_CONFIG : cache config/routes/views for production performance
# These are irrelevant when running locally with `php artisan serve`.
# ---------------------------------------------------------------------------
RUN_MIGRATIONS=false
RUN_SEEDERS=false
CACHE_APP_CONFIG=true

VITE_APP_NAME="${APP_NAME}"
