# ---------------------------------------------------------------------------
# PRODUCTION environment template (Railway / Render / any container host).
#
# Every value with a blank right-hand side MUST be set on the host. NEVER commit
# a filled-in copy of this file and never paste real secrets into the repository.
#
# On Railway you do NOT copy this file into the image. Instead paste the
# variables into the service's "Variables" tab (see docs/RAILWAY_DEPLOYMENT.md).
# This file is the checklist of what to paste.
# ---------------------------------------------------------------------------

APP_NAME="Azure Bay Hotel"
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=                       # e.g. https://hotel-api-production.up.railway.app
ASSET_URL=                     # optional CDN/asset host; leave blank to use APP_URL

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# ---------------------------------------------------------------------------
# Hashing: Argon2id + per-user salt + application pepper
# ---------------------------------------------------------------------------
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4
ARGON_VERIFY=true
BCRYPT_ROUNDS=12

# Secrets - generate with: php artisan security:generate-secrets
# Keep the SAME values across deploys: changing APP_ENCRYPTION_KEY makes every
# encrypted guest field unreadable, and changing APP_PASSWORD_PEPPER locks every
# user out until they reset their password.
APP_PASSWORD_PEPPER=
APP_PASSWORD_PEPPER_PREVIOUS=
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Email OTP (two-factor authentication)
# ---------------------------------------------------------------------------
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS_PER_HOUR=5
TWO_FACTOR_CHALLENGE_MINUTES=10

# MUST be false in production. `true` prints the one-time code on the login
# screen instead of emailing it.
TWO_FACTOR_EXPOSE_CODE=false

# HaveIBeenPwned range API check (needs outbound network). Optional.
PASSWORD_CHECK_BREACHED=true

# Login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=60

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database - MySQL 8 / MariaDB 10.6+
#
# On Railway: add the MySQL plugin, then reference its variables on the app
# service so they stay in sync:
#   DB_HOST=${{MySQL.MYSQLHOST}}      DB_PORT=${{MySQL.MYSQLPORT}}
#   DB_DATABASE=${{MySQL.MYSQLDATABASE}}  DB_USERNAME=${{MySQL.MYSQLUSER}}
#   DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions / cache / queue - all backed by the database, so a single container
# is enough and state survives redeploys.
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true       # requires HTTPS - Railway/Render provide it
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------------
# Mail - delivers two-factor codes and backup failure alerts.
# Use a real transactional provider in production (SES / Mailgun / Postmark /
# Brevo), or Gmail SMTP with an App Password. `log` writes codes to the log
# file only and is NOT acceptable in production.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="benjaminaneefi316@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Backups -> encrypted MySQL dump -> Amazon S3
#   BACKUP_DRIVER=local : simulate on disk, no AWS credentials needed
#   BACKUP_DRIVER=s3    : upload to the bucket below
# ---------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_DRIVER=s3
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_ENABLED=true
BACKUP_TIME=02:30
BACKUP_TIMEZONE=UTC
BACKUP_TIMEOUT_SECONDS=900
BACKUP_ALERT_EMAIL=benjaminaneefi316@gmail.com

MYSQLDUMP_BINARY=
BACKUP_DUMP_ROUTINES=false
BACKUP_DUMP_EVENTS=false

# ---------------------------------------------------------------------------
# AWS - least privilege. Never commit real credentials; inject them here or
# (better) attach an instance/task role. See docs/AWS_DEPLOYMENT.md.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_BACKUP_BUCKET=
AWS_BACKUP_PREFIX=hotel-backups
AWS_BACKUP_SSE=AES256
AWS_BACKUP_KMS_KEY_ID=
AWS_BACKUP_STORAGE_CLASS=STANDARD_IA
AWS_BACKUP_VERSIONING=true
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Container boot behaviour (read by docker/entrypoint.sh)
# ---------------------------------------------------------------------------
RUN_MIGRATIONS=true        # apply migrations on every boot (idempotent)
RUN_SEEDERS=true           # seed ONCE, only when the database is empty
CACHE_APP_CONFIG=true      # config/route/view cache for production speed

VITE_APP_NAME="${APP_NAME}"
